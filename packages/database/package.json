{
  "name": "@vendorguard/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.20.0",
    "typescript": "5.6.3",
    "vitest": "2.1.3",
    "tsx": "4.19.1",
    "@types/node": "22.7.5"
  }
}
