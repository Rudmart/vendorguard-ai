{
  "name": "vendorguard-ai",
  "version": "0.1.0",
  "private": true,
  "description": "VendorGuard AI - AI-powered third-party risk management portal (portfolio project)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "eval": "turbo run eval --filter=./evaluations/*",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @vendorguard/database db:migrate",
    "db:seed": "pnpm --filter @vendorguard/database db:seed",
    "db:generate": "pnpm --filter @vendorguard/database db:generate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "prettier": "3.9.6",
    "eslint": "10.8.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0"
  }
}
